{
  "name": "adobe-xd-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI assistants read Adobe XD (.xd) files: artboards, layers, text, colors, fonts, previews and assets. Read-only and sandboxed to folders you choose.",
  "type": "module",
  "bin": { "adobe-xd-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node test/smoke.mjs && node test/security.mjs"
  },
  "engines": { "node": ">=18" },
  "keywords": ["mcp", "model-context-protocol", "adobe-xd", "xd", "design", "figma-alternative", "claude", "cursor", "codex", "gemini"],
  "author": "srayan-uxd",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/srayan-uxd/adobe-xd-mcp.git" },
  "homepage": "https://github.com/srayan-uxd/adobe-xd-mcp#readme",
  "bugs": { "url": "https://github.com/srayan-uxd/adobe-xd-mcp/issues" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
